<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
    <!-- 
        PRODUCTION CONFIGURATION: Trust only system certificates
        This is the secure default configuration for production apps
    -->
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <!-- Trust only pre-installed CA certificates (system certificates) -->
            <certificates src="system" />
        </trust-anchors>
    </base-config>
    
    
    <!--
        LOCALHOST CONFIGURATION: Allow cleartext traffic for localhost (development only)
        Remove or disable this in production builds
    -->
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="true">localhost</domain>
        <domain includeSubdomains="true">127.0.0.1</domain>
        <domain includeSubdomains="true">10.0.2.2</domain>
    </domain-config>
</network-security-config>
